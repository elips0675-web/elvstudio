{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "demo-static",
  "trailingSlash": true,
  "redirects": [
    { "source": "/index.php", "destination": "/", "permanent": true },
    { "source": "/template", "destination": "/kit/", "permanent": true },
    { "source": "/template/", "destination": "/kit/", "permanent": true },
    { "source": "/blog/page/1/", "destination": "/blog/", "permanent": true },
    { "source": "/blog/page/5/", "destination": "/blog/page/4/", "permanent": true },
    { "source": "/blog/category/:slug/page/1/", "destination": "/blog/category/:slug/", "permanent": true },
    { "source": "/blog/category/engineering/page/2/", "destination": "/blog/category/engineering/", "permanent": true },
    { "source": "/blog/category/seo/page/2/", "destination": "/blog/category/seo/", "permanent": true },
    { "source": "/blog/category/content/page/2/", "destination": "/blog/category/content/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/preview/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/themes/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
